---
import '../styles/global.css';
import type { ComponentProps } from 'astro/types';

type Props = ComponentProps<'div'> & {
  title: string;
  description?: string;
  active?: 'gids' | 'zenders' | 'status';
};

const { title, description = 'Gratis TV- en sportgids voor België en Nederland', active } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const B = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0f14" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="TV & Sport" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="manifest" href={`${B}manifest.webmanifest`} />
    <link rel="icon" type="image/svg+xml" href={`${B}icons/icon.svg`} />
    <link rel="apple-touch-icon" href={`${B}icons/icon-180.png`} />
    <title>{title}</title>
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(`${B}sw.js`).catch(() => {});
        });
      }
    </script>
  </head>
  <body>
    <header class="app-header">
      <a class="brand" href={B}>
        <span>TV&nbsp;&amp;&nbsp;Sport Gids</span>
        <span class="badge">Gratis</span>
      </a>
      <nav class="app-nav">
        <a href={B} class:list={{ active: active === 'gids' }}>
          <span>Gids</span>
        </a>
        <a href={`${B}instellingen`} class:list={{ active: active === 'zenders' }}>
          <span class="label">Mijn</span> zenders
        </a>
        <a href={`${B}admin`} class:list={{ active: active === 'status' }}>
          <span class="label">Status</span>
        </a>
      </nav>
    </header>
    <slot />
  </body>
</html>

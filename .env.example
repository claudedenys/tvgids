# Kopieer naar .env (niet committen). Alle waarden zijn optioneel.

# Opslagmap voor de JSON-"database" (standaard: <project>/data)
# DATA_DIR=/data

# Automatische EPG-update in productie (uit: false)
# AUTO_UPDATE=true
# AUTO_UPDATE_INTERVAL=21600000
# IMPORT_DAYS=5

# Beveiliging van /api/update (POST) — zet een sterke waarde in productie
# ADMIN_KEY=

# Site-URL (gebruikt voor canonical links)
# SITE_URL=https://example.com
